# IRODORI-VOICE 用の VOICEVOX エディタ設定
# VOICEVOX エディタはこの .env を読んで、既定で接続するエンジンを決めます。

VITE_APP_NAME=irodori-voice-editor
VITE_DEFAULT_ENGINE_INFOS=`[
    {
        "uuid": "0b2a5f31-9c4d-4f6a-8e7b-3d1c5a9f2e40",
        "name": "IRODORI-VOICE Engine",
        "executionEnabled": false,
        "executionFilePath": "",
        "executionArgs": [],
        "host": "http://127.0.0.1:50121"
    }
]`
VITE_OFFICIAL_WEBSITE_URL=https://github.com/Aratako/Irodori-TTS
VITE_LATEST_UPDATE_INFOS_URL=http://127.0.0.1:50121/update_infos.json
VITE_GTM_CONTAINER_ID=GTM-DUMMY

# executionEnabled と executionFilePath は、通常 start-voicevox-editor.bat が
# 環境変数 VITE_DEFAULT_ENGINE_INFOS で上書きします。エディタは .env よりも
# 環境変数を優先して読むため、この 2 つの値はバッチから起動するかぎり使われません。
# バッチ側は Python（runtime → 隣の Irodori-TTS/.venv → PATH）と、固めた実行
# ファイルを順に探して絶対パスで渡します。環境ごとに違うパスを、このファイルへ
# 書き残さずに済ませるための作りです。
#
# ここに書いてある executionEnabled=false が効くのは、バッチを通さずに
# `pnpm run electron:serve` を直接叩いた場合だけです。そのときはエンジンが
# 起動しないため、start-engine.bat で別途立ち上げてください。
#
# VITE_LATEST_UPDATE_INFOS_URL はエンジン自身が空の一覧を返すエンドポイントを
# 指しています。外部サイトへ問い合わせないため、オフラインでも起動できます。
