# IRODORI-VOICE 配布ビルド用のエディタ設定
#
# コンパイル.bat が、これを editor-voicevox/.env.production として配置します。
# 開発中に使う .env とは次の 2 点が違います。
#
#   1. executionEnabled が true で、エディタがエンジンを子プロセスとして起動します
#      （開発中は start-voicevox-editor.bat が環境変数で同じことをしています）
#   2. VOICEVOX_ENGINE_DIR で、実行ファイルへ固めたエンジンの場所を指定します
#      electron-builder がこのフォルダを vv-engine として同梱します
#
# dotenv は先に読んだ値を優先するため、.env より .env.production が勝ちます。

VITE_APP_NAME=irodori-voice-editor
VITE_DEFAULT_ENGINE_INFOS=`[
    {
        "uuid": "0b2a5f31-9c4d-4f6a-8e7b-3d1c5a9f2e40",
        "name": "IRODORI-VOICE Engine",
        "executionEnabled": true,
        "executionFilePath": "vv-engine/irodori-voice-engine.exe",
        "executionArgs": [],
        "host": "http://127.0.0.1:50121"
    }
]`
VITE_OFFICIAL_WEBSITE_URL=https://github.com/Aratako/Irodori-TTS
VITE_LATEST_UPDATE_INFOS_URL=http://127.0.0.1:50121/update_infos.json
VITE_GTM_CONTAINER_ID=GTM-DUMMY

# 実行ファイルへ固めたエンジンの場所。editor-voicevox からの相対で書きます。
# build-engine.bat（またはコンパイル.bat）の出力先と一致している必要があります。
VOICEVOX_ENGINE_DIR=../engine/dist/irodori-voice-engine/
